{
    "tasks": [
        {
            "type": "process",
            "label": "CMake: build Windows Memory Auditor",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build all project sources using the configured CMake toolchain."
        }
    ],
    "version": "2.0.0"
}
